@{
    ViewData["Title"] = "Carrusel";
}

<div class="container my-5">
    <h1 class="fw-bold text-center mb-4 border-bottom pb-2">📖 Guía de Carrusel en Bootstrap</h1>
    <p class="lead text-center">
        El componente <strong>Carousel</strong> en Bootstrap permite mostrar imágenes o contenido en forma de diapositivas
        que se desplazan automáticamente o mediante controles. Es ideal para galerías o presentaciones destacadas.
    </p>

    <!-- Carrusel con captions -->
    <h2 class="mb-3 text-primary fs-4 text-decoration-underline">🔹 Carrusel con Indicadores y Captions</h2>
    <p>
        Este carrusel incluye:
        <ul>
            <li><code>.carousel-indicators</code>: botones que indican la posición de cada diapositiva.</li>
            <li><code>.carousel-inner</code>: contenedor de las diapositivas (<code>.carousel-item</code>).</li>
            <li><code>.carousel-caption</code>: texto superpuesto en cada imagen.</li>
            <li><code>.carousel-control-prev</code> y <code>.carousel-control-next</code>: botones para navegar entre diapositivas.</li>
        </ul>
    </p>

    <div id="carouselExampleCaptions" class="carousel slide">
        <!-- Indicadores -->
        <div class="carousel-indicators">
            <button type="button" class="active bg-black" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" class="bg-black" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" class="bg-black" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <!-- Diapositivas -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://sm.ign.com/t/ign_latam/screenshot/default/santos-saint-seiya_8qvu.1280.jpg" class="d-block w-100" alt="12 caballeros">
                <div class="carousel-caption d-none d-md-block">
                    <h5 class="text-black">Primera diapositiva</h5>
                    <p class="text-black">Ejemplo de contenido representativo para la primera imagen.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="https://i0.wp.com/fronterasdefantasia.com/wp-content/uploads/2024/01/Diapositiva1-1.jpg?resize=1024%2C576&ssl=1" class="d-block w-100" alt="Atena">
                <div class="carousel-caption d-none d-md-block">
                    <h5 class="text-black">Segunda diapositiva</h5>
                    <p class="text-black">Ejemplo de contenido representativo para la segunda imagen.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="https://img2.rtve.es/i/?w=1200&i=https://img.rtve.es/imagenes/caballeros-del-zodiaco-alma-dorada/1460978487133.jpg" class="d-block w-100" alt="Leo">
                <div class="carousel-caption d-none d-md-block">
                    <h5 class="text-white">Tercera diapositiva</h5>
                    <p class="text-white">Ejemplo de contenido representativo para la tercera imagen.</p>
                </div>
            </div>
        </div>

        <!-- Controles -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>