@{
    ViewData["Title"] = "Acordeon";
}

<div class="container my-5">
    <h1 class="fw-bold text-center mb-4 border-bottom pb-2">📖 Guía de Accordions en Bootstrap</h1>
    <p class="lead text-center">
        El componente <strong>Accordion</strong> en Bootstrap permite mostrar y ocultar contenido de manera elegante,
        usando transiciones y colapsos. Es ideal para organizar información en secciones expandibles.
    </p>

    <!-- Accordion normal -->
    <h2 class="mb-3 text-center fs-4 text-primary">🔹 Accordion Normal</h2>
    <p>
        El <code>.accordion</code> básico muestra secciones plegables con bordes y separación estándar.
        Cada <code>.accordion-item</code> contiene un encabezado (<code>.accordion-header</code>) y un botón (<code>.accordion-button</code>)
        que controla la apertura/cierre del contenido (<code>.accordion-collapse</code>).
    </p>

    <div class="accordion" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    Sección 1
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <strong>Este es el contenido de la primera sección.</strong> Se muestra por defecto.
                    Aquí puedes colocar texto, listas, imágenes o cualquier otro elemento HTML.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    Sección 2
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <strong>Este es el contenido de la segunda sección.</strong> Está oculto por defecto y se muestra al hacer clic en el encabezado.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                    Sección 3
                </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <strong>Este es el contenido de la tercera sección.</strong> Puedes personalizarlo con cualquier tipo de contenido.
                </div>
            </div>
        </div>
    </div>

    <!-- Accordion flush -->
    <h2 class="mt-5 mb-3 text-center fs-4 text-secondary">🔹 Accordion Flush</h2>
    <p>
        El <code>.accordion-flush</code> elimina los bordes y el fondo del accordion,
        ofreciendo un diseño más minimalista y limpio. Es útil cuando quieres que el contenido se integre mejor con el resto de la página.
    </p>

    <div class="accordion accordion-flush" id="accordionFlushExample">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                    Sección Flush 1
                </button>
            </h2>
            <div id="flush-collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">Contenido de la primera sección con estilo flush.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTwo" aria-expanded="false" aria-controls="flush-collapseTwo">
                    Sección Flush 2
                </button>
            </h2>
            <div id="flush-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">Contenido de la segunda sección con estilo flush.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseThree" aria-expanded="false" aria-controls="flush-collapseThree">
                    Sección Flush 3
                </button>
            </h2>
            <div id="flush-collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">Contenido de la tercera sección con estilo flush.</div>
            </div>
        </div>
    </div>
</div>
