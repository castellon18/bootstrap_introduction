@{
    ViewData["Title"] = "Colores";
}

<div class="container my-5">
    <h1 class="fw-bold text-center mb-4 border-bottom pb-2">🎨 Colores en Bootstrap 5.3.3</h1>
    <p class="lead text-center">
        Bootstrap ofrece una paleta de colores predefinidos que podemos aplicar en textos, fondos, botones y alertas.
        Aquí tienes una guía visual de los principales colores.
    </p>

    <!-- Sección de textos -->
    <h2 class="fw-semibold mt-5 mb-3">🔹 Colores en Texto</h2>
    <p class="text-primary">Texto con <code>.text-primary</code></p>
    <p class="text-secondary">Texto con <code>.text-secondary</code></p>
    <p class="text-success">Texto con <code>.text-success</code></p>
    <p class="text-danger">Texto con <code>.text-danger</code></p>
    <p class="text-warning">Texto con <code>.text-warning</code></p>
    <p class="text-info">Texto con <code>.text-info</code></p>
    <p class="text-dark">Texto con <code>.text-dark</code></p>
    <p class="text-muted">Texto con <code>.text-muted</code></p>
    <p class="text-light bg-dark">Texto con <code>.text-light</code> (sobre fondo oscuro)</p>

    <!-- Sección de fondos -->
    <h2 class="fw-semibold mt-5 mb-3">🔹 Colores en Fondos</h2>
    <div class="p-3 mb-2 bg-primary text-white">Fondo <code class="text-white-50">.bg-primary</code></div>
    <div class="p-3 mb-2 bg-primary bg-gradient text-white">Fondo <code class="text-white-50">.bg-primary bg-gradient</code></div>
    <div class="p-3 mb-2 bg-secondary text-white">Fondo <code class="text-white-50">.bg-secondary</code></div>
    <div class="p-3 mb-2 bg-secondary bg-gradient text-white">Fondo <code class="text-white-50">.bg-secondary bg-gradient</code></div>
    <div class="p-3 mb-2 bg-success text-white">Fondo <code class="text-white-50">.bg-success</code></div>
    <div class="p-3 mb-2 bg-success bg-gradient text-white">Fondo <code class="text-white-50">.bg-success bg-gradient</code></div>
    <div class="p-3 mb-2 bg-danger text-white">Fondo <code class="text-white-50">.bg-danger</code></div>
    <div class="p-3 mb-2 bg-danger bg-gradient text-white">Fondo <code class="text-white-50">.bg-danger bg-gradient</code></div>
    <div class="p-3 mb-2 bg-warning text-dark">Fondo <code class="text-white-50">.bg-warning</code></div>
    <div class="p-3 mb-2 bg-warning bg-gradient text-dark">Fondo <code class="text-white-50">.bg-warning bg-gradient</code></div>
    <div class="p-3 mb-2 bg-info text-dark">Fondo <code class="text-white-50">.bg-info</code></div>
    <div class="p-3 mb-2 bg-info bg-gradient text-dark">Fondo <code class="text-white-50">.bg-info bg-gradient</code></div>
    <div class="p-3 mb-2 bg-light text-dark">Fondo <code>.bg-light</code></div>
    <div class="p-3 mb-2 bg-dark text-white">Fondo <code class="text-white-50">.bg-dark</code></div>
    <div class="p-3 mb-2 bg-dark bg-gradient text-white">Fondo <code class="text-white-50">.bg-dark bg-gradient</code></div>

    <!-- Sección de botones -->
    <h2 class="fw-semibold mt-5 mb-3">🔹 Colores en Botones</h2>
    <button class="btn btn-primary">Primary</button>
    <button class="btn btn-secondary">Secondary</button>
    <button class="btn btn-success">Success</button>
    <button class="btn btn-danger">Danger</button>
    <button class="btn btn-warning">Warning</button>
    <button class="btn btn-info">Info</button>
    <button class="btn btn-light">Light</button>
    <button class="btn btn-dark">Dark</button>

    <!-- Sección de alertas -->
    <h2 class="fw-semibold mt-5 mb-3">🔹 Colores en Alertas</h2>
    <div class="alert alert-primary">Alerta Primary</div>
    <div class="alert alert-secondary">Alerta Secondary</div>
    <div class="alert alert-success">Alerta Success</div>
    <div class="alert alert-danger">Alerta Danger</div>
    <div class="alert alert-warning">Alerta Warning</div>
    <div class="alert alert-info">Alerta Info</div>
    <div class="alert alert-light">Alerta Light</div>
    <div class="alert alert-dark">Alerta Dark</div>
</div>