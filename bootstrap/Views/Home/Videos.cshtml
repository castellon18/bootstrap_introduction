@{
    ViewData["Title"] = "Videos";
}
<div class="container my-5">
    <h1 class="fw-bold text-center mb-4 border-bottom pb-2">🎥 Videos con Bootstrap</h1>
    <p class="lead text-center">
        Bootstrap nos ofrece una clase utilitaria para cambiar las dimensiones dinamicamente del video, según las
        las dimensiones del dispositivo del usuario.
    </p>

    <!-- Ejemplo 1: video sin ratio -->
    <h2 class="fw-semibold mt-5 mb-3 text-primary">🔹 Ejemplo 1: Video sin la clase ratio</h2>
    <iframe width="560" height="315" src="https://www.youtube.com/embed/EZXg3ZabHzA?si=3oTTq9EJpP5-xGQN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>

    <!-- Ejemplo 2: video con ratio -->
    <h2 class="fw-semibold mt-5 mb-3 text-success">🔹 Ejemplo 2: Video con ratio de 16x9</h2>
    <div class="ratio ratio-16x9">
        <iframe width="560" height="315" src="https://www.youtube.com/embed/EZXg3ZabHzA?si=3oTTq9EJpP5-xGQN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>

    <!-- Ejemplo 3: Usando ratio con otras clases de bootstrap -->
    <h2 class="fw-semibold mt-5 mb-3 text-danger">🔹 Ejemplo 3: Usando ratio con la clase <code>.row</code></h2>
    <div class="row gy-3">
        <div class="col-md-4">
            <div class="ratio ratio-16x9">
                <iframe width="560" height="315" src="https://www.youtube.com/embed/EZXg3ZabHzA?si=3oTTq9EJpP5-xGQN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ratio ratio-16x9">
                <iframe width="560" height="315" src="https://www.youtube.com/embed/EZXg3ZabHzA?si=3oTTq9EJpP5-xGQN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ratio ratio-16x9">
                <iframe width="560" height="315" src="https://www.youtube.com/embed/EZXg3ZabHzA?si=3oTTq9EJpP5-xGQN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</div>