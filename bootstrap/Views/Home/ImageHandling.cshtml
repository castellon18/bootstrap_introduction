@{
    ViewData["Title"] = "Manejo Imagen";
}

<div class="container my-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-light">
            <h4 class="text-primary fw-bold mb-0">📸 Manejo de Imágenes en Bootstrap</h4>
        </div>

        <div class="card-body">
            <p class="mb-4">
                Bootstrap ofrece clases utilitarias para trabajar imágenes de forma responsiva,
                elegante y consistente. Aquí algunos ejemplos prácticos:
            </p>

            <!-- Galería responsiva -->
            <h5 class="text-secondary fw-semibold mb-3">🔹 Galería Responsiva</h5>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <img class="img-fluid rounded shadow-sm" src="https://i.pinimg.com/474x/76/bc/d1/76bcd1cf2124c8928fce248582d6d337.jpg" alt="Imagen ejemplo 1" />
                </div>
                <div class="col-6 col-md-3">
                    <img class="img-fluid rounded shadow-sm" src="https://i.pinimg.com/474x/76/bc/d1/76bcd1cf2124c8928fce248582d6d337.jpg" alt="Imagen ejemplo 2" />
                </div>
                <div class="col-6 col-md-3">
                    <img class="img-fluid rounded shadow-sm" src="https://i.pinimg.com/474x/76/bc/d1/76bcd1cf2124c8928fce248582d6d337.jpg" alt="Imagen ejemplo 3" />
                </div>
                <div class="col-6 col-md-3">
                    <img class="img-fluid rounded shadow-sm" src="https://i.pinimg.com/474x/76/bc/d1/76bcd1cf2124c8928fce248582d6d337.jpg" alt="Imagen ejemplo 4" />
                </div>
            </div>

            <!-- Imagen destacada -->
            <h5 class="text-secondary fw-semibold mt-5 mb-3">🔹 Imagen Destacada con Estilos</h5>
            <div class="text-center">
                <img class="img-thumbnail rounded-circle shadow-lg"
                     src="https://priceschool.usc.edu/wp-content/uploads/2013/05/arnold-schwarzenegger-headshot-654x500-1.jpg"
                     alt="Arnold Schwarzenegger"
                     style="max-width: 200px;" />
                <p class="mt-2 text-muted">Ejemplo de imagen circular con <code>.rounded-circle</code> y <code>.img-thumbnail</code>.</p>
            </div>
        </div>
    </div>
</div>